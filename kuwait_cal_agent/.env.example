# Vertex AI / Enterprise Configuration for Google ADK (google-adk 2.x)
# Copy this file to `kuwait_cal_agent/.env` and set your project ID.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Dashboard Owner & Schedule Settings
CAL_OWNER_EMAIL=clappaert@google.com
CAL_TIMEZONE=Asia/Kuwait
